# ──────────────────────────────────────────────────────────────────────────────
# ScrapeWerse — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Bright Data Scraper Studio API key
# Get from: https://brightdata.com → Account → API Tokens
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Bright Data Collector (Scraper Studio) IDs for each source
BRIGHTDATA_DEVPOST_COLLECTOR_ID=your_devpost_collector_id_here
BRIGHTDATA_UNSTOP_HACKATHON_COLLECTOR_ID=your_unstop_collector_id_here
BRIGHTDATA_UNSTOP_COMPETITION_COLLECTOR_ID=your_unstop_collector_id_here
BRIGHTDATA_HACK2SKILL_COLLECTOR_ID=your_hack2skill_collector_id_here
BRIGHTDATA_DUMMYWEBSITE_COLLECTOR_ID=your_dummywebsite_collector_id_here

# Google Cloud Firestore project ID
# Get from: https://console.firebase.google.com → Project Settings
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# (Optional) Firebase API key for REST unauthenticated access
# Required only if Firestore security rules allow key-based access
FIREBASE_API_KEY=your_firebase_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# Pipeline Settings
# ──────────────────────────────────────────────────────────────────────────────

# Maximum number of self-healing poll attempts before giving up
SELF_HEAL_MAX_ATTEMPTS=15

# Seconds to wait between self-healing status polls
SELF_HEAL_POLL_INTERVAL=3

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
